<?xml version="1.0" ?>
<!--
Speed Course World - 135' x 47' (41.15m x 14.33m)
36" wide path, U-shaped with 3 laps
Curves: 6', 10', 20', 30', 40', 50', 55.3', 60' radius sections
-->
<sdf version="1.8">
  <world name="speed_course">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>1e-5</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>15 10 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 25</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 25</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== START/FINISH ZONES ==================== -->

    <!-- START ZONE (Green) - 32" wide, at Y=0 -->
    <model name="start_zone">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.81 2.4 0.01</size></box></geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- FINISH ZONE (Yellow) - 32" wide, at Y=41.15m (135 feet) -->
    <model name="finish_zone">
      <static>true</static>
      <pose>0 41.15 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.81 2.4 0.01</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== COURSE STRUCTURE ==================== -->
    <!-- The speed course is a U-shaped path with switchback curves at each end.
         Left and right sides run parallel straight sections, with curves at bottom and top.
         Track width (inside to outside): ~0.9m (36 inches)
    -->

    <!-- ========== BOTTOM LEFT TURN (Outer radius curves: 55.3' to 25.3') ========== -->
    <!-- This is the tight switchback at Y=0; creates the U-turn -->

    <!-- Left outer wall - large radius curve transitioning through 55.3', 45.3', 35.3', 25.3' -->
    <!-- Approximated as concentric circle sections -->
    <model name="bottom_left_outer_r55">
      <static>true</static>
      <pose>-8.4 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>16.85</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="bottom_left_inner_r45">
      <static>true</static>
      <pose>-8.4 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>15.95</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- ========== STRAIGHT LEFT SECTION (44 feet = 13.41m) ========== -->
    <!-- Runs from bottom left curve to top left curve, 36" wide path -->
    <model name="left_straight_section">
      <static>true</static>
      <pose>-7.0 20.6 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>13.41 0.9 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>13.41 0.9 0.05</size></box></geometry>
          <material>
            <ambient>0.8 0.4 0 1</ambient>
            <diffuse>0.8 0.4 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== TOP LEFT TURN (Tight curves: 10', 6' radii) ========== -->
    <!-- Innermost switchback to reverse direction -->
    <model name="top_left_tight_outer_r10">
      <static>true</static>
      <pose>-8.4 39.2 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>3.05</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="top_left_tight_inner_r6">
      <static>true</static>
      <pose>-8.4 39.2 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>2.15</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- ========== BOTTOM RIGHT TURN (Mirror of left) ========== -->
    <model name="bottom_right_outer_r55">
      <static>true</static>
      <pose>8.4 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>16.85</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="bottom_right_inner_r45">
      <static>true</static>
      <pose>8.4 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>15.95</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- ========== STRAIGHT RIGHT SECTION (44 feet = 13.41m) ========== -->
    <model name="right_straight_section">
      <static>true</static>
      <pose>7.0 20.6 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>13.41 0.9 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>13.41 0.9 0.05</size></box></geometry>
          <material>
            <ambient>0.8 0.4 0 1</ambient>
            <diffuse>0.8 0.4 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== TOP RIGHT TURN ========== -->
    <model name="top_right_tight_outer_r10">
      <static>true</static>
      <pose>8.4 39.2 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>3.05</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="top_right_tight_inner_r6">
      <static>true</static>
      <pose>8.4 39.2 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>2.15</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- ==================== HAY BALE BARRIERS (lining both sides) ==================== -->

    <!-- Left side hay bales - outer perimeter -->
    <model name="haybale_left_outer">
      <static>true</static>
      <pose>-9.5 20.6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 13.41 0.6</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 13.41 0.6</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.4 1</ambient>
            <diffuse>0.9 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right side hay bales - outer perimeter -->
    <model name="haybale_right_outer">
      <static>true</static>
      <pose>9.5 20.6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 13.41 0.6</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 13.41 0.6</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.4 1</ambient>
            <diffuse>0.9 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Left bottom turn hay bales -->
    <model name="haybale_left_bottom">
      <static>true</static>
      <pose>-10.0 2.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.8 0.4 1</ambient>
            <diffuse>0.9 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right bottom turn hay bales -->
    <model name="haybale_right_bottom">
      <static>true</static>
      <pose>10.0 2.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.8 0.4 1</ambient>
            <diffuse>0.9 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Left top turn hay bales -->
    <model name="haybale_left_top">
      <static>true</static>
      <pose>-10.0 39.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.8 0.4 1</ambient>
            <diffuse>0.9 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right top turn hay bales -->
    <model name="haybale_right_top">
      <static>true</static>
      <pose>10.0 39.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.8 0.4 1</ambient>
            <diffuse>0.9 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
