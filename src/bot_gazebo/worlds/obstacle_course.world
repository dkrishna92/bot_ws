    <!-- ==================== OBSTACLES INSIDE THE TRACK ==================== -->

    <!-- RAMP SECTION: Straight up + helical down with side rails -->
    <model name="ramp_up">
      <static>true</static>
      <pose>3.5 2.5 0.25 0.20 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.81 1.2 0.05</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.81 1.2 0.05</size></box></geometry>
          <material>
