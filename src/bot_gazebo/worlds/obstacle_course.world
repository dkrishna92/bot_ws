<?xml version="1.0" ?>
<!--
Obstacle Course World - 65' x 48' (19.81m x 14.63m)
Track bounded by hay bales on BOTH sides (inner and outer).
Hoops are vertical rings for the bot to pass through.
Pothole region is a bumpy road surface.
Robot completes 2 laps.
-->
<sdf version="1.8">
  <world name="obstacle_course">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>1e-5</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>10 10 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>25 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>25 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== START/FINISH ZONE ==================== -->
    <model name="start_zone">
      <static>true</static>
      <pose>10.0 1.5 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.81 2.0 0.02</size></box></geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== HAY BALE TRACK BOUNDARIES (OUTER + INNER) ==================== -->

    <!-- BOTTOM SECTION: Outer boundaries -->
    <model name="haybale_bottom_left_outer">
      <static>true</static>
      <pose>8.3 1.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 1.5 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.5 0.6</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.4 1</ambient>
            <diffuse>0.9 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="haybale_bottom_right_outer">
      <static>true</static>
      <pose>11.7 1.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 1.5 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.5 0.6</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.4 1</ambient>
            <diffuse>0.9 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- BOTTOM SECTION: Inner boundaries -->
