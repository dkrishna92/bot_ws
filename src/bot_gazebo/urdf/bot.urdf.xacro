<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bot">

  <!-- Constants -->
  <xacro:property name="base_length" value="0.61"/>  <!-- 24 inches -->
  <xacro:property name="base_width" value="0.41"/>   <!-- 16 inches -->
  <xacro:property name="base_height" value="0.15"/>  <!-- chassis height -->
  <xacro:property name="wheel_radius" value="0.1"/>  <!-- wheel radius -->
  <xacro:property name="wheel_width" value="0.08"/>  <!-- wheel width -->
  <xacro:property name="wheelbase" value="0.50"/>    <!-- distance between wheels -->
  <xacro:property name="track_width" value="0.35"/>  <!-- width between wheel centers -->
  <xacro:property name="mass_base" value="11.3"/>    <!-- 25 lbs in kg -->
  <xacro:property name="mass_wheel" value="0.5"/>

  <!-- Base Link (Chassis) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass_base}"/>
      <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="chassis_color">
        <color rgba="0.2 0.2 0.8 1.0"/>  <!-- Blue -->
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Wheel macro, instantiated for all four corners below. Skid-steer
       drivetrain; the left pair shares one Pololu G2 channel, the right
       pair shares the other, so both wheels on a side always spin together
       (matches the diff_drive plugin's multi-joint-per-side config below;
       there is no caster, all four wheels are driven). -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass_wheel}"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_color">
          <color rgba="0.1 0.1 0.1 1.0"/>  <!-- Black -->
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <!-- type is "continuous" (not "revolute"). These are driven wheels and
         need unlimited rotation. A revolute joint requires <limit> and a
         lower=upper=0 limit (an earlier version of this file had exactly
         that) welds the wheel at zero rotation, so it can never turn no
         matter what the diff_drive plugin commands. -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <origin xyz="${x_reflect * wheelbase/2} ${y_reflect * track_width/2} ${wheel_radius}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <gazebo reference="${prefix}_wheel">
      <material>Gazebo/Black</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
  <xacro:wheel prefix="rear_left" x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
  <xacro:wheel prefix="rear_right" x_reflect="-1" y_reflect="-1"/>

  <!-- Lidar Link -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <material name="lidar_color">
        <color rgba="0.3 0.3 0.3 1.0"/>  <!-- Gray -->
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Camera Link -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.12 0.06"/>
      </geometry>
      <material name="camera_color">
        <color rgba="0.4 0.4 0.4 1.0"/>  <!-- Dark gray -->
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.12 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Lidar Joint -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0 ${base_height + 0.06}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- Camera Joint -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="${base_length/2 - 0.05} 0 ${base_height/2 + 0.05}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- Gazebo plugins -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Differential (skid-steer) Drive Plugin (gz-sim). Two joints per side,
       matching the real drivetrain; the Pololu G2's left channel drives
       front_left+rear_left together, right channel drives
       front_right+rear_right together, and this plugin commands both
       joints on a side identically, same as the real motor driver does
       electrically. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_wheel_torque>20</max_wheel_torque>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <!-- Publishes joint positions on gz-transport so robot_state_publisher
         can compute base_link -> *_wheel TF. Without this the wheel joints
         are non-fixed (continuous) but nothing reports their position, so
         robot_state_publisher has nothing to publish their transform from. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

  <!-- Lidar Sensor (simulates RPLIDAR) - gz-sim gpu_lidar -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>6.283</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.3</min>
          <max>12</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Camera Sensor (simulates OAK-D) - gz-sim -->
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/image_raw</topic>
    </sensor>
  </gazebo>

</robot>
