<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bot">

  <!-- Constants -->
  <xacro:property name="base_length" value="0.445"/>  <!-- 0.445 m = 17.5 in -->
  <xacro:property name="base_width" value="0.255"/>   <!-- 0.255 m = 10.0 in -->
  <xacro:property name="base_height" value="0.176"/>  <!-- chassis height, 0.176 m = 6.9 in -->
  <!-- Gap between the ground and the underside of the chassis (0.06 m =
       2.4 in). Without it the chassis box was modelled spanning
       z=0..base_height, i.e. sitting flat on the floor rather than riding
       on the wheels. That is wrong on its own terms, though it was not
       what blocked turning: see the wheel friction block below for that. -->
  <xacro:property name="ground_clearance" value="0.06"/>
  <xacro:property name="wheel_radius" value="0.06"/>  <!-- 0.06 m = 2.4 in radius (4.7 in dia) -->
  <xacro:property name="wheel_width" value="0.06"/>  <!-- 0.06 m = 2.4 in -->
  <xacro:property name="wheelbase" value="0.33"/>    <!-- front-to-rear axle spacing, 0.33 m = 13.0 in -->
  <xacro:property name="track_width" value="0.32"/>  <!-- left-to-right wheel-centre spacing, 0.32 m = 12.6 in -->
  <xacro:property name="mass_base" value="3.2"/>    <!-- 3.2 kg = 7.0 lb -->
  <xacro:property name="mass_wheel" value="0.2"/>   <!-- 0.2 kg = 0.44 lb each -->
  <!-- OAK-D S2 housing (~91 x 28 x 17.5 mm) and its measured mount height:
       bottom of the housing 9 cm above the ground (measured 2026-09-25).
       camera_link is the housing centre, which is also where
       depthai_ros_driver hangs its oak-* optical frames (parent_frame). -->
  <xacro:property name="oak_width" value="0.091"/>
  <xacro:property name="oak_height" value="0.028"/>
  <xacro:property name="oak_depth" value="0.0175"/>
  <xacro:property name="oak_bottom_height" value="0.09"/>
  <!-- Sensor placement, measured on the robot 2026-09-25 (relative to the
       OAK housing, which is easy to measure against):
       - OAK front panel is the robot's front edge (its 3 cm stand-off from
         the chassis is already inside base_length), on the centreline
         (lateral position assumed, not measured).
       - Lidar centre is 3.5 cm behind the OAK front panel, 5.5 cm from the
         OAK's left edge (i.e. 0.95 cm right of the OAK centre), and the
         lidar top is 5 cm above the OAK top.
       RPLIDAR S2 body is 77 mm dia x 38.85 mm tall (datasheet). lidar_link
       sits on the scan plane, estimated 13 mm below the top of the head
       (not measured; check against the window slit on the rotating head). -->
  <xacro:property name="oak_front_x" value="${base_length/2}"/>
  <xacro:property name="lidar_radius" value="0.0385"/>
  <xacro:property name="lidar_body_height" value="0.03885"/>
  <xacro:property name="lidar_top_height" value="${oak_bottom_height + oak_height + 0.05}"/>
  <xacro:property name="lidar_plane_below_top" value="0.013"/>

  <!-- Base Link (Chassis) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass_base}"/>
      <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${ground_clearance + base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="chassis_color">
        <color rgba="0.2 0.2 0.8 1.0"/>  <!-- Blue -->
      </material>
    </visual>
    <collision name="base_collision">
      <origin xyz="0 0 ${ground_clearance + base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Wheel macro, instantiated for all four corners below. Skid-steer
       drivetrain; the left pair shares one Pololu G2 channel, the right
       pair shares the other, so both wheels on a side always spin together
       (matches the diff_drive plugin's multi-joint-per-side config below;
       there is no caster, all four wheels are driven). -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass_wheel}"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_color">
          <color rgba="0.1 0.1 0.1 1.0"/>  <!-- Black -->
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <!-- type is "continuous" (not "revolute"). These are driven wheels and
         need unlimited rotation. A revolute joint requires <limit> and a
         lower=upper=0 limit (an earlier version of this file had exactly
         that) welds the wheel at zero rotation, so it can never turn no
         matter what the diff_drive plugin commands. -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <origin xyz="${x_reflect * wheelbase/2} ${y_reflect * track_width/2} ${wheel_radius}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <gazebo reference="${prefix}_wheel">
      <material>Gazebo/Black</material>
      <!-- Anisotropic tyre friction. This is what makes skid-steer
           pivoting possible at all: a 4-wheel skid-steer can only rotate
           by scrubbing all four tyres sideways, so lateral friction (mu1,
           along fdir1) is low while rolling traction (mu2) stays high.

           fdir1 is the WHEEL AXLE direction, but written as "0 0 1"
           because fdir1 is expressed in the COLLISION frame and the
           collision above is rotated rpy="pi/2 0 0", which maps the link's
           Y axis onto the collision's Z. Getting this wrong is not a
           subtle inaccuracy, it silently disables the whole friction
           split: "0 1 0" here points along the contact normal, which is
           degenerate, so the engine discards it and picks an arbitrary
           direction. With that (and with the earlier isotropic 0.8/0.8)
           the robot could not rotate AT ALL: a commanded 1.0 rad/s gave
           exactly 0 deg of yaw while the wheels counter-rotated correctly,
           so wheel odometry integrated turns that never happened and
           heading was lost at every turn. With fdir1 correct, a 10s pivot
           at 1.0 rad/s yields ~443 deg of real rotation.

           The axle is also the only spin-invariant axis to aim fdir1
           along: the wheel link rotates about it, so the friction split
           stays put instead of tumbling with the wheel.

           No <slip1>/<slip2> are set. They are not needed here: the
           anisotropy alone reproduces realistic scrub (wheel odometry
           over-reports a pivot by ~28%, which is why ekf_params.yaml gives
           yaw to the IMU rather than the wheels). Add slip compliance only
           if tyre modelling needs to get finer. -->
      <mu1>0.05</mu1>
      <mu2>1.0</mu2>
      <fdir1>0 0 1</fdir1>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
  <xacro:wheel prefix="rear_left" x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
  <xacro:wheel prefix="rear_right" x_reflect="-1" y_reflect="-1"/>

  <!-- Lidar Link -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${lidar_plane_below_top - lidar_body_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_body_height}"/>
      </geometry>
      <material name="lidar_color">
        <color rgba="0.3 0.3 0.3 1.0"/>  <!-- Gray -->
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${lidar_plane_below_top - lidar_body_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_body_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Camera Link -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${oak_depth} ${oak_width} ${oak_height}"/>
      </geometry>
      <material name="camera_color">
        <color rgba="0.4 0.4 0.4 1.0"/>  <!-- Dark gray -->
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${oak_depth} ${oak_width} ${oak_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- IMU Link -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="imu_color">
        <color rgba="0.9 0.1 0.1 1.0"/>  <!-- Red -->
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Lidar Joint. base_link's origin is at ground level (wheels are
       centred at z=wheel_radius, so they touch the floor), so z IS the scan
       plane's height above ground: ~0.155 m, above the OAK's top (0.118 m)
       so the beam clears the camera. Measured position: see the sensor
       placement properties at the top of this file. The live scan confirms
       no self-returns (nothing closer than 0.32 m, 2026-09-25). -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="${oak_front_x - 0.035} ${oak_width/2 - 0.055} ${lidar_top_height - lidar_plane_below_top}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- Camera Joint. z is measured (base_link's origin is at ground level,
       see lidar_joint): housing bottom at oak_bottom_height, so its centre
       is half a housing-height above that (~0.104 m), below the lidar's
       scan plane. x puts the front panel at the robot's front edge. -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="${oak_front_x - oak_depth/2} 0 ${oak_bottom_height + oak_height/2}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- IMU Joint, mounted flush at the chassis center (no offset needed
       the way lidar/camera need clearance/forward placement), x-forward
       z-up matching base_link's own axes so imu_link's orientation
       readings need no extra rotation to interpret in base_link/odom. -->
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- Gazebo plugins -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <!-- Diagnostic contact sensor - publishes actual collision events for
         base_link so real collisions (e.g. clipping a bale) can be observed
         directly instead of inferred from TF/cmd_vel mismatches. Requires
         the gz-sim-contact-system plugin to be loaded on the world (see
         bot_gazebo/worlds/*_cfr.world) - unlike camera/lidar, contact
         sensors produce no output at all without it. The referenced
         collision name must match base_link's <collision name="...">
         above: sdformat_urdf does NOT name an unnamed URDF collision
         "collision" (it uses <link>_collision), so the name is set
         explicitly on both sides to avoid a silent no-match.
         An explicit <topic> avoids having to guess gz-sim's auto-generated
         hierarchical topic name when bridging in gazebo_sim.launch.py. -->
    <sensor name="base_contact_sensor" type="contact">
      <contact>
        <collision>base_collision</collision>
        <topic>/bot_contacts</topic>
      </contact>
      <update_rate>30</update_rate>
    </sensor>
  </gazebo>

  <!-- IMU sensor (real part: Bosch BNO055) - feeds robot_localization's EKF
       (see bot_bringup/config/ekf_params.yaml) so heading is tracked from
       gyro/orientation between SLAM scan-match corrections, not just wheel
       odometry. Requires the gz-sim-imu-system plugin loaded on the world
       (see bot_gazebo/worlds/*_cfr.world) - same story as the contact
       sensor above, it produces no output at all without it.

       Noise stddevs below are approximated from the BNO055 datasheet's
       noise-density specs (gyro ~0.014 deg/s/sqrt(Hz), accel ~150
       ug/sqrt(Hz)), converted to a per-sample stddev at this sensor's
       100Hz update_rate via stddev = density * sqrt(update_rate/2). This
       is a standard approximation (treats the sensor as white noise
       band-limited to Nyquist), not a substitute for validating against
       the actual datasheet or real-hardware calibration once the BNO055
       is mounted - see CLAUDE.md's open items. gz-sim's IMU sensor has no
       way to attach noise/covariance to the orientation output itself
       (only angular_velocity/linear_acceleration below); its
       orientation_covariance will read back all-zero regardless. -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <!-- Same reason as the lidar/camera sensors: without this the
           bridged message carries gz's scoped sensor name
           ("bot/base_link/imu_sensor") as its frame_id. That frame is not
           in the TF tree, so robot_localization cannot transform the IMU
           into base_link and silently DROPS every sample: the EKF's yaw
           then sat at 0 while the IMU itself was correctly reporting the
           turn, which is the whole reason imu0 exists in
           ekf_params.yaml. -->
      <gz_frame_id>imu_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0104</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0104</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0104</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Differential (skid-steer) Drive Plugin (gz-sim). Two joints per side,
       matching the real drivetrain; the Pololu G2's left channel drives
       front_left+rear_left together, right channel drives
       front_right+rear_right together, and this plugin commands both
       joints on a side identically, same as the real motor driver does
       electrically. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <!-- Real motor: Pololu #4843, 20.4:1 25D 12V HP gearmotor. Extrapolated
           stall torque is 7.4 kg-cm (~0.73 N-m) per wheel; the previous 20
           N-m here was a placeholder ~27x too high, letting sim pivot-turns
           succeed unrealistically easily in-place skid-steer rotation
           needs torque in roughly this same 0.6-0.9 N-m range just to
           overcome scrub friction (see CLAUDE.md), so this is a genuinely
           load-bearing limit now, not a formality. -->
      <max_wheel_torque>0.73</max_wheel_torque>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <!-- Publishes joint positions on gz-transport so robot_state_publisher
         can compute base_link -> *_wheel TF. Without this the wheel joints
         are non-fixed (continuous) but nothing reports their position, so
         robot_state_publisher has nothing to publish their transform from.
         Explicit <topic> pins a fixed name instead of the default
         /world/<world>/model/<model>/joint_state, whose <world> segment is
         the world file's INTERNAL name (e.g. cfr_speed_course), not its
         filename/launch-arg (speed_course_cfr), bridging the auto name
         would silently miss, leaving no wheel links in TF. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <!-- Ground-truth pose publisher, sim-only diagnostic, NOT part of the
         real robot's sensor suite. DiffDrive's /odom above is kinematic
         (integrated from wheel joint angle, zero-slip assumed), not physics
         ground truth: if the chassis is wedged/colliding while the wheels
         still spin, /odom over-reports displacement and slam_toolbox gets
         fed a wrong believed pose. This publishes the model's actual
         world-frame pose so scripts/compare_odom_to_ground_truth.py can
         catch exactly that divergence, see the frontier exploration
         investigation notes in CLAUDE.md. use_pose_vector_msg left at its
         default (false); with one model and publish_model_pose the only
         thing enabled, this publishes plain gz.msgs.Pose on
         /model/bot/pose per the plugin's default topic-naming convention
         (confirmed against /opt/.../gz-sim8/worlds/pose_publisher.sdf),
         double check via `gz topic -l | grep bot` after first launch,
         same as the contact sensor topic above. -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <static_publisher>false</static_publisher>
      <update_frequency>30</update_frequency>
    </plugin>
  </gazebo>

  <!-- Lidar Sensor (simulates RPLIDAR) - gz-sim gpu_lidar -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <!-- Without this, gz-sim stamps scan messages with its own scoped
           entity name ("bot/base_link/lidar_sensor") instead of the URDF
           link name, and nothing in the TF tree matches that, so
           tf2_ros::MessageFilter (used by slam_toolbox, RViz, etc.) can
           never resolve it and silently drops every single scan forever. -->
      <gz_frame_id>lidar_link</gz_frame_id>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>6.283</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.3</min>
          <max>12</max>
          <resolution>0.01</resolution>
        </range>
        <!-- Excludes visuals tagged visibility_flags=1 (bit 0) - the
             obstacle course's ramp/bridge/helix deck surfaces, see
             obstacle_course_cfr.world. gpu_lidar renders the scene to
             compute ranges (unlike the older CPU "ray"/"lidar" sensor
             types, which raycast against physics collision instead), so
             this visibility_mask/visibility_flags mechanism works here;
             it has no effect on physics - the wheels still collide with
             and climb the deck normally. Rail visuals are deliberately
             left at the default (visible) so the local costmap still sees
             them as lateral boundaries. Default mask is all-bits
             (4294967295 = 0xFFFFFFFF); clearing bit 0
             (4294967294 = 0xFFFFFFFE) makes this lidar blind to anything
             tagged with only that bit, while every other visual (flags
             still all-bits by default) keeps satisfying
             (mask & flags) != 0 and stays visible as normal. -->
        <visibility_mask>4294967294</visibility_mask>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Camera Sensor (simulates OAK-D) - gz-sim -->
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <!-- see the lidar sensor above for why this is needed -->
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/image_raw</topic>
    </sensor>

    <!-- Depth Sensor (simulates the OAK-D S2's stereo depth output) -
         gz-sim depth_camera, co-located with camera_sensor above since on
         the real hardware both RGB and depth come off the same OAK-D S2
         (stereo depth aligned into the RGB frame, per
         bot_bringup/config/oak_params.yaml's stereo.i_align_depth: true).
         gz-sim's depth_camera sensor auto-publishes a second topic at
         "<topic>/points" (a PointCloudPacked) alongside the depth image on
         "<topic>" itself, with no extra plugin needed - gazebo_sim.launch.py
         bridges that points topic to /oak/points, matching the real-hardware
         topic bringup.launch.py's depth_image_proc node publishes to. The
         voxel_layer in nav2_params.yaml/nav2_mapping_params.yaml consumes
         whichever one is live via that same /oak/points topic name. -->
    <sensor name="oak_depth_sensor" type="depth_camera">
      <!-- see the lidar sensor above for why this is needed -->
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <!-- OAK-D S2 stereo depth's usable range is roughly 0.2m-6m
               (shorter/noisier than the RGB camera's clip above) - matches
               voxel_layer's obstacle_max_range: 3.0 in nav2_params.yaml
               with headroom rather than clipping right at it. -->
          <near>0.2</near>
          <far>6.0</far>
        </clip>
        <!-- Same ramp-deck exclusion as lidar_sensor above (see that
             sensor's comment) - this is the voxel_layer's other
             obstacle-marking source, so it needs the same treatment or the
             deck would still get marked via /oak/points even with the
             lidar fixed. camera_sensor (RGB, above) deliberately keeps the
             default mask - no reason to hide the ramp from a plain image. -->
        <visibility_mask>4294967294</visibility_mask>
      </camera>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>oak/depth</topic>
    </sensor>
  </gazebo>

</robot>
