<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bot_imu</name>
  <version>0.1.0</version>
  <description>Bosch BNO055 IMU driver node (I2C, NDOF fusion mode). Publishes sensor_msgs/Imu for robot_localization's EKF.</description>
  <maintainer email="krishna.dontaraju@gmail.com">Krishna</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- smbus2 has no standard rosdep key: pip install smbus2 (or apt install
       python3-smbus2) on the Pi. Not required on dev machines; bno055_node
       runs in dry-run mode without it. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
