<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bot_web_control</name>
  <version>0.1.0</version>
  <description>Localhost web dashboard: start/stop the race or mapping launch, view the live /map, and teleop (WASD, gazebo-style) with adjustable linear/angular speed. Dev/ops convenience tool, not part of the robot's own runtime behavior -- uses only Python stdlib (http.server, zlib for PNG encoding) so it adds no new dependencies.</description>
  <maintainer email="krishna.dontaraju@gmail.com">Krishna</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- For the SaveMap service type (checkpoint save/resume) -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Not imported directly -- this package launches bringup.launch.py /
       mapping.launch.py as `ros2 launch` subprocesses, so it can't run
       anything useful without bot_bringup installed. -->
  <exec_depend>bot_bringup</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
