<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bot_safety</name>
  <version>0.1.0</version>
  <description>Secondary, defense-in-depth ROS 2 watchdog node. Mirrors the primary MCU e-stop status onto /system_fault and asserts fault on stack-level failures (e.g. stale lidar scans). This is NOT the primary safety mechanism -- the hard real-time &lt;1s cutoff lives on a dedicated MCU, electrically isolated from this ROS 2 stack.</description>
  <maintainer email="krishna.dontaraju@gmail.com">Krishna</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <!-- lgpio: apt install python3-lgpio on the Pi (scripts/setup_pi.sh does
       this). RPi.GPIO doesn't work on the Pi 5. Not required on dev
       machines; watchdog_node skips the GPIO fault line without it. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
