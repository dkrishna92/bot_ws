<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bot_bringup</name>
  <version>0.1.0</version>
  <description>Bringup package: top-level launch files and config that compose the DIY Robot Challenge vehicle's nodes. Contains no node implementations of its own -- those live in bot_motor, bot_ultrasonic, bot_safety, and bot_perception. Sensor drivers with existing ROS 2 packages (RPLIDAR, OAK-D) are launched from their upstream packages, not reimplemented here.</description>
  <maintainer email="krishna.dontaraju@gmail.com">Krishna</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>bot_motor</exec_depend>
  <exec_depend>bot_ultrasonic</exec_depend>
  <exec_depend>bot_safety</exec_depend>
  <exec_depend>bot_perception</exec_depend>
  <exec_depend>bot_gazebo</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>bot_explore</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
